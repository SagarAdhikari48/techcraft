{
  "name": "techcraft-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run mock-server\" \"ng serve\"",
    "start:ng": "ng serve",
    "mock-server": "node mock-server/generate-db.mjs && json-server --watch mock-server/db.json --routes mock-server/routes.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "json-server": "^0.17.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3",
    "zone.js": "^0.16.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
